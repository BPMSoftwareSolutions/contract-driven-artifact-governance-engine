{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.local/schemas/governed-artifact-contract.schema.json",
  "title": "Governed Artifact Contract",
  "description": "Admitted authority for one complete artifact family and its conformance proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "artifacts",
    "claims",
    "conformance",
    "contract",
    "dependencies",
    "designAuthority",
    "effects",
    "exclusions",
    "interpretationBase",
    "lineage",
    "projectionLedger",
    "receipt",
    "runtimeAuthorities",
    "subject",
    "workspace"
  ],
  "properties": {
    "$schema": {
      "const": "https://canonical.local/schemas/governed-artifact-contract.schema.json"
    },
    "contract": {
      "$ref": "#/$defs/contractIdentity"
    },
    "interpretationBase": {
      "$ref": "#/$defs/interpretationBase"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "projectionLedger": {
      "$ref": "#/$defs/projectionLedger"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "runtimeAuthorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtimeAuthority"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimPolicy"
      }
    },
    "lineage": {
      "$ref": "#/$defs/canonicalLineage"
    },
    "designAuthority": {
      "$ref": "#/$defs/conversationDesignAuthority"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "invocation": {
      "type": "string",
      "pattern": "^(?:new )?[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "minLength": 1,
      "maxLength": 320
    },
    "contractIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType",
        "contractId",
        "status",
        "contractVersion"
      ],
      "properties": {
        "contractType": {
          "const": "governed-artifact-contract.v1"
        },
        "contractId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "admitted"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "admittedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "interpretationBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "schema",
        "conformanceProfile",
        "projectorRegistry",
        "verifierRegistry",
        "migrationRegistry"
      ],
      "properties": {
        "engine": {
          "$ref": "#/$defs/admittedDependency"
        },
        "schema": {
          "$ref": "#/$defs/admittedDependency"
        },
        "conformanceProfile": {
          "$ref": "#/$defs/admittedDependency"
        },
        "projectorRegistry": {
          "$ref": "#/$defs/admittedDependency"
        },
        "verifierRegistry": {
          "$ref": "#/$defs/admittedDependency"
        },
        "migrationRegistry": {
          "$ref": "#/$defs/admittedDependency"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "subjectId",
        "purpose",
        "authority"
      ],
      "properties": {
        "subjectType": {
          "$ref": "#/$defs/identifier"
        },
        "subjectId": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority": true
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot",
        "artifactRoot",
        "governedScope"
      ],
      "properties": {
        "workspaceRoot": {
          "$ref": "#/$defs/relativePath"
        },
        "artifactRoot": {
          "$ref": "#/$defs/relativePath"
        },
        "governedScope": {
          "$ref": "#/$defs/governedScope"
        },
        "pathExceptions": {
          "$ref": "#/$defs/workspacePathExceptions"
        }
      }
    },
    "governedScope": {
      "oneOf": [
        {
          "$ref": "#/$defs/exclusiveSubtreeScope"
        },
        {
          "$ref": "#/$defs/declaredArtifactScope"
        }
      ]
    },
    "exclusiveSubtreeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "inventoryMode",
        "governedDirectories",
        "outsideScopePosture",
        "requiredDisposition"
      ],
      "properties": {
        "scopeType": {
          "const": "exclusive-artifact-subtree.v1"
        },
        "inventoryMode": {
          "const": "exclusive-subtree"
        },
        "governedDirectories": {
          "const": []
        },
        "outsideScopePosture": {
          "const": "outside-authority"
        },
        "requiredDisposition": {
          "const": "ARTIFACT_SCOPE_CLOSED"
        }
      }
    },
    "declaredArtifactScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "inventoryMode",
        "governedDirectories",
        "outsideScopePosture",
        "requiredDisposition"
      ],
      "properties": {
        "scopeType": {
          "const": "declared-artifact-scope.v1"
        },
        "inventoryMode": {
          "const": "declared-paths"
        },
        "governedDirectories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "outsideScopePosture": {
          "const": "outside-authority"
        },
        "requiredDisposition": {
          "const": "ARTIFACT_SCOPE_CLOSED"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactKind",
        "purpose",
        "relativePath",
        "mediaType",
        "projection",
        "relationships",
        "proof"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "artifactKind": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "sourceAuthority": {
          "$ref": "#/$defs/sourceAuthority"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyId",
        "specifier",
        "allowedImports",
        "allowedInvocations",
        "usedByArtifacts",
        "authority"
      ],
      "properties": {
        "dependencyId": {
          "$ref": "#/$defs/identifier"
        },
        "specifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "allowedImports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\*|default|[A-Za-z_$][A-Za-z0-9_$]*)$"
          },
          "uniqueItems": true
        },
        "allowedInvocations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|default|[A-Za-z_$][A-Za-z0-9_$]*)(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
          },
          "uniqueItems": true
        },
        "usedByArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "authority": {
          "oneOf": [
            {
              "$ref": "#/$defs/portAuthority"
            },
            {
              "$ref": "#/$defs/artifactAuthority"
            }
          ]
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectId",
        "operation",
        "usedByArtifacts",
        "authority"
      ],
      "properties": {
        "effectId": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
        },
        "usedByArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "authority": {
          "$ref": "#/$defs/portAuthority"
        }
      }
    },
    "runtimeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeAuthorityId",
        "invocation",
        "usedByArtifacts",
        "purpose"
      ],
      "properties": {
        "runtimeAuthorityId": {
          "$ref": "#/$defs/identifier"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "usedByArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "portAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "portId",
        "effect"
      ],
      "properties": {
        "authorityType": {
          "const": "port-authority.v1"
        },
        "portId": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "artifactAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "artifactId",
        "responsibilityId",
        "semanticEdge"
      ],
      "properties": {
        "authorityType": {
          "const": "artifact-authority.v1"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "semanticEdge": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarations",
        "responsibilities",
        "semanticEdges",
        "decisions",
        "iterations",
        "failurePolicies",
        "projectionMappings",
        "resultContracts",
        "forbiddenSyntaxKinds"
      ],
      "properties": {
        "declarations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "uniqueItems": true
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/responsibility"
          }
        },
        "semanticEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticEdge"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionAuthority"
          }
        },
        "iterations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/iterationAuthority"
          }
        },
        "failurePolicies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failurePolicy"
          }
        },
        "projectionMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectionMapping"
          }
        },
        "resultContracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultContract"
          }
        },
        "forbiddenSyntaxKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syntaxKind"
          },
          "uniqueItems": true
        }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibilityId",
        "responsibilityType",
        "declaration",
        "purpose"
      ],
      "properties": {
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityType": {
          "enum": [
            "function",
            "module"
          ]
        },
        "declaration": {
          "type": "string",
          "pattern": "^(?:<module>|[A-Za-z_$][A-Za-z0-9_$]*)$"
        },
        "functionKind": {
          "enum": [
            "arrow-function",
            "function-declaration",
            "function-expression",
            "method-declaration"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "responsibilityType": {
                "const": "function"
              }
            }
          },
          "then": {
            "properties": {
              "functionKind": {}
            },
            "required": [
              "functionKind"
            ]
          },
          "else": {
            "not": {
              "required": [
                "functionKind"
              ]
            }
          }
        }
      ]
    },
    "semanticEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "responsibilityId",
        "edgeKind",
        "operation",
        "argumentExpressions",
        "occurrences",
        "authorities",
        "purpose"
      ],
      "properties": {
        "edgeId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "edgeKind": {
          "enum": [
            "invocation",
            "reference"
          ]
        },
        "operation": {
          "$ref": "#/$defs/invocation"
        },
        "argumentExpressions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityReference"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorityReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/dependencyAuthorityReference"
        },
        {
          "$ref": "#/$defs/effectAuthorityReference"
        },
        {
          "$ref": "#/$defs/runtimeAuthorityReference"
        },
        {
          "$ref": "#/$defs/responsibilityAuthorityReference"
        },
        {
          "$ref": "#/$defs/projectionAuthorityReference"
        },
        {
          "$ref": "#/$defs/failureAuthorityReference"
        },
        {
          "$ref": "#/$defs/resultAuthorityReference"
        }
      ]
    },
    "dependencyAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "dependencyId"
      ],
      "properties": {
        "authorityType": {
          "const": "dependency-authority"
        },
        "dependencyId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "effectAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "effectId"
      ],
      "properties": {
        "authorityType": {
          "const": "effect-authority"
        },
        "effectId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "runtimeAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "runtimeAuthorityId"
      ],
      "properties": {
        "authorityType": {
          "const": "runtime-authority"
        },
        "runtimeAuthorityId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "responsibilityAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "responsibilityId"
      ],
      "properties": {
        "authorityType": {
          "const": "responsibility-authority"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "projectionAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "projectionMappingId"
      ],
      "properties": {
        "authorityType": {
          "const": "projection-authority"
        },
        "projectionMappingId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "failureAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "failurePolicyId"
      ],
      "properties": {
        "authorityType": {
          "const": "failure-authority"
        },
        "failurePolicyId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "resultAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "resultContractId"
      ],
      "properties": {
        "authorityType": {
          "const": "result-authority"
        },
        "resultContractId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "decisionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "responsibilityId",
        "syntaxKind",
        "conditionExpression",
        "occurrences",
        "policy"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "syntaxKind": {
          "enum": [
            "ConditionalExpression",
            "IfStatement",
            "LogicalAndExpression",
            "LogicalOrExpression",
            "NullishCoalescingExpression",
            "SwitchStatement"
          ]
        },
        "conditionExpression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "iterationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterationId",
        "responsibilityId",
        "syntaxKind",
        "controlExpression",
        "occurrences",
        "continuationPolicy",
        "terminationPolicy"
      ],
      "properties": {
        "iterationId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "syntaxKind": {
          "enum": [
            "DoStatement",
            "ForStatement",
            "WhileStatement"
          ]
        },
        "controlExpression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "continuationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "terminationPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failurePolicyId",
        "responsibilityId",
        "syntaxKind",
        "occurrences",
        "policy"
      ],
      "properties": {
        "failurePolicyId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "syntaxKind": {
          "enum": [
            "CatchClause",
            "ThrowStatement",
            "TryStatement"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "syntaxKind"
            ],
            "properties": {
              "syntaxKind": {
                "const": "ThrowStatement"
              }
            }
          },
          "then": {
            "required": [
              "expression"
            ],
            "properties": {
              "expression": {}
            }
          }
        }
      ]
    },
    "projectionMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionMappingId",
        "responsibilityId",
        "occurrences",
        "fields",
        "purpose"
      ],
      "properties": {
        "projectionMappingId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectionField"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectionField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputField",
        "sourceExpression"
      ],
      "properties": {
        "outputField": {
          "type": "string",
          "minLength": 1
        },
        "sourceExpression": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultContractId",
        "resultKind",
        "mediaType",
        "source",
        "purpose"
      ],
      "properties": {
        "resultContractId": {
          "$ref": "#/$defs/identifier"
        },
        "resultKind": {
          "$ref": "#/$defs/identifier"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/returnResultSource"
            },
            {
              "$ref": "#/$defs/effectResultSource"
            }
          ]
        },
        "projectionMapping": {
          "$ref": "#/$defs/projectionMappingReference"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "returnResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "responsibilityId",
        "returnKind",
        "expression",
        "occurrences"
      ],
      "properties": {
        "sourceType": {
          "const": "return"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "returnKind": {
          "enum": [
            "explicit-return",
            "implicit-return"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "effectResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "effectId",
        "semanticEdgeId",
        "argumentIndex",
        "valueExpression",
        "occurrences"
      ],
      "properties": {
        "sourceType": {
          "const": "effect"
        },
        "effectId": {
          "$ref": "#/$defs/identifier"
        },
        "semanticEdgeId": {
          "$ref": "#/$defs/identifier"
        },
        "argumentIndex": {
          "type": "integer",
          "minimum": 0
        },
        "valueExpression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "projectionMappingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "projectionMappingId"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "projectionMappingId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "syntaxKind": {
      "enum": [
        "CatchClause",
        "ConditionalExpression",
        "DebuggerStatement",
        "DoStatement",
        "DynamicImportExpression",
        "ForStatement",
        "IfStatement",
        "LogicalAndExpression",
        "LogicalOrExpression",
        "NullishCoalescingExpression",
        "ObjectLiteralExpression",
        "ReturnStatement",
        "SwitchStatement",
        "ThrowStatement",
        "TryStatement",
        "WhileStatement",
        "WithStatement"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectorId",
        "authorityId",
        "authority"
      ],
      "properties": {
        "projectorId": {
          "$ref": "#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "#/$defs/identifier"
        },
        "authority": {
          "oneOf": [
            {
              "$ref": "#/$defs/jsonAuthority"
            },
            {
              "$ref": "#/$defs/textAuthority"
            },
            {
              "$ref": "#/$defs/tokenAuthority"
            },
            {
              "$ref": "#/$defs/contractMarkdownAuthority"
            }
          ]
        }
      }
    },
    "jsonAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "value"
      ],
      "properties": {
        "authorityType": {
          "const": "canonical-json-value.v1"
        },
        "value": true
      }
    },
    "textAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "text"
      ],
      "properties": {
        "authorityType": {
          "const": "utf8-text.v1"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "tokenAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "language",
        "tokens"
      ],
      "properties": {
        "authorityType": {
          "const": "lossless-source-tokens.v1"
        },
        "language": {
          "enum": [
            "javascript",
            "typescript"
          ]
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "contractMarkdownAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "documentTitle",
        "documentStatusLabel",
        "futureStatePreview",
        "reviewerPerspective",
        "sectionOrder",
        "reviewChecklist"
      ],
      "properties": {
        "authorityType": {
          "const": "governed-artifact-contract-markdown.v1"
        },
        "documentTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "documentStatusLabel": {
          "const": "Governed review projection"
        },
        "futureStatePreview": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!#)(?!```)[^\\r\\n]+$"
          }
        },
        "reviewerPerspective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "objective",
            "outcome"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            }
          }
        },
        "sectionOrder": {
          "const": [
            "future-state-preview",
            "reviewer-perspective",
            "governing-loop",
            "contract-authority",
            "semantic-subject",
            "artifact-family",
            "projection-authorities",
            "dependency-authorities",
            "effect-authorities",
            "runtime-authorities",
            "source-authority-closures",
            "authority-closure-profile",
            "artifact-scope-authority",
            "operation-authorities",
            "artifact-relationships",
            "exclusions",
            "conformance-evaluation",
            "terminal-dispositions",
            "receipt-requirements",
            "claim-policies",
            "review-checklist"
          ]
        },
        "reviewChecklist": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipType",
        "artifactId"
      ],
      "properties": {
        "relationshipType": {
          "$ref": "#/$defs/identifier"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierIds",
        "contentSha256",
        "expectedByteLength"
      ],
      "properties": {
        "verifierIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedByteLength": {
          "type": "integer",
          "minimum": 0
        },
        "metaSchemaValidationRequired": {
          "const": true
        },
        "requiredSections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#{1,6} [^\\r\\n]+$"
          },
          "uniqueItems": true
        },
        "forbiddenText": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "validThroughUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactEvaluations"
      ],
      "properties": {
        "artifactEvaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactEvaluation"
          }
        }
      }
    },
    "artifactEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "verifierId",
        "command",
        "expectedExitCode",
        "expectedStdoutContains"
      ],
      "properties": {
        "evaluationId": {
          "$ref": "#/$defs/identifier"
        },
        "verifierId": {
          "const": "command-exit-verifier.v1"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedExitCode": {
          "type": "integer"
        },
        "expectedStdoutContains": {
          "type": "string"
        }
      }
    },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "claim"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/identifier"
        },
        "claim": {
          "enum": [
            "COMPLETE",
            "CONTRACT_AUTHORITY_CLOSED",
            "TRUSTED"
          ]
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath"
      ],
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "projectionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath"
      ],
      "properties": {
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "workspacePathExceptions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exceptionId",
          "path"
        ],
        "properties": {
          "exceptionId": {
            "$ref": "#/$defs/identifier"
          },
          "path": {
            "$ref": "#/$defs/relativePath"
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "package-lock-digest": {
                "$ref": "#/$defs/sha256"
              },
              "package-manager-identity": {
                "type": "string",
                "minLength": 1
              },
              "repository-head-identity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "canonicalLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "projectId",
        "features",
        "scenarios",
        "obligations",
        "responsibilities"
      ],
      "properties": {
        "authorityType": {
          "const": "canonical-lineage-authority.v1"
        },
        "projectId": {
          "$ref": "#/$defs/identifier"
        },
        "features": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "featureId",
              "projectId",
              "purpose"
            ],
            "properties": {
              "featureId": {
                "$ref": "#/$defs/identifier"
              },
              "projectId": {
                "$ref": "#/$defs/identifier"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "scenarioId",
              "featureId",
              "purpose"
            ],
            "properties": {
              "scenarioId": {
                "$ref": "#/$defs/identifier"
              },
              "featureId": {
                "$ref": "#/$defs/identifier"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "obligations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationId",
              "scenarioId",
              "statement"
            ],
            "properties": {
              "obligationId": {
                "$ref": "#/$defs/identifier"
              },
              "scenarioId": {
                "$ref": "#/$defs/identifier"
              },
              "statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "responsibilities": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "responsibilityId",
              "obligationId",
              "responsibilityType",
              "projectionProfileId",
              "artifactId"
            ],
            "properties": {
              "responsibilityId": {
                "$ref": "#/$defs/identifier"
              },
              "obligationId": {
                "$ref": "#/$defs/identifier"
              },
              "responsibilityType": {
                "$ref": "#/$defs/identifier"
              },
              "projectionProfileId": {
                "$ref": "#/$defs/identifier"
              },
              "artifactId": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "conversationDesignAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "conversationDigest",
        "decisions",
        "deviations",
        "tieOut"
      ],
      "properties": {
        "authorityType": {
          "const": "conversation-design-authority.v1"
        },
        "conversationDigest": {
          "$ref": "#/$defs/sha256"
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decisionId",
              "source",
              "statement",
              "disposition"
            ],
            "properties": {
              "decisionId": {
                "$ref": "#/$defs/identifier"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "enum": [
                  "accepted",
                  "deferred",
                  "modified",
                  "rejected"
                ]
              }
            }
          }
        },
        "deviations": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decisionId",
              "proposed",
              "implemented",
              "reason",
              "impact"
            ],
            "properties": {
              "decisionId": {
                "$ref": "#/$defs/identifier"
              },
              "proposed": {
                "type": "string",
                "minLength": 1
              },
              "implemented": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tieOut": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decisionId",
              "artifactIds"
            ],
            "properties": {
              "decisionId": {
                "$ref": "#/$defs/identifier"
              },
              "artifactIds": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      }
    }
  }
}
