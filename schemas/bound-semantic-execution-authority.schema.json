{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.local/schemas/bound-semantic-execution-authority.schema.json",
  "title": "Bound semantic execution authority",
  "description": "The complete authored semantic subject of one governed execution. It declares meaning only. Execution bindings, the execution graph, bound schema digests, proof requirements, and the runtime profile are derived by projection and are therefore not declarable here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorityType",
    "authorityId",
    "ontologyId",
    "inputConceptId",
    "semanticLayer",
    "ontology",
    "context"
  ],
  "properties": {
    "authorityType": {
      "const": "bound-semantic-execution-authority.v1"
    },
    "authorityId": {
      "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/identifier"
    },
    "ontologyId": {
      "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/identifier"
    },
    "inputConceptId": {
      "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/identifier"
    },
    "semanticLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concepts",
        "relations",
        "properties",
        "facts"
      ],
      "properties": {
        "concepts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/concept"
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/relation"
          }
        },
        "properties": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/property"
          }
        },
        "facts": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/fact"
          }
        }
      }
    },
    "ontology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classifications",
        "constraints",
        "translations",
        "obligations",
        "transformations",
        "results",
        "arithmeticOperations",
        "randomDraws",
        "indexedReads",
        "iterations"
      ],
      "properties": {
        "classifications": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/classification"
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/constraint"
          }
        },
        "translations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/translation"
          }
        },
        "obligations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/obligation"
          }
        },
        "transformations": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/transformation"
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/resultUnion"
          }
        },
        "arithmeticOperations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/boundedArithmeticOperation"
          }
        },
        "randomDraws": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/seededRangeDraw"
          }
        },
        "indexedReads": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/indexedRead"
          }
        },
        "iterations": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/boundedIteration"
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemas",
        "catalogs",
        "executionBinding"
      ],
      "properties": {
        "schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaId",
              "value"
            ],
            "properties": {
              "schemaId": {
                "$ref": "https://canonical.local/schemas/semantic-execution-bundle.schema.json#/$defs/identifier"
              },
              "value": {
                "type": "object"
              }
            }
          }
        },
        "catalogs": {
          "const": []
        },
        "executionBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "executorPortId",
            "runtimeProfileId",
            "serializationProfileId"
          ],
          "properties": {
            "executorPortId": {
              "const": "semantic-authority-runtime.v1"
            },
            "runtimeProfileId": {
              "const": "finite-semantic-runtime.v3"
            },
            "serializationProfileId": {
              "const": "canonical-json.v1"
            }
          }
        }
      }
    }
  }
}
