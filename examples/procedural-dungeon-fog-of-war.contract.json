    "decisions": [
      {
        "decisionId": "single-file-deliverable",
        "disposition": "accepted",
        "source": "Deliverable requirement in the game-engineering brief",
        "statement": "Ship the dungeon generator as one self-contained HTML file with no external libraries or dependencies."
      },
      {
        "decisionId": "map-generation-engine-choice",
        "disposition": "accepted",
        "source": "Choice between BSP and cellular automata for the map-generation engine",
        "statement": "Use Binary Space Partitioning rather than cellular automata, because BSP connects every sibling room pair by construction and needs no separate pocket-connection pass."
      },
      {
        "decisionId": "vision-radius-nine",
        "disposition": "accepted",
        "source": "Core mechanics requirement for an 8-10 tile visibility radius",
        "statement": "Fix the fog-of-war vision radius at 9 tiles."
      },
      {
        "decisionId": "persistent-fog-memory",
        "disposition": "accepted",
        "source": "The visibility grid is specified with exactly two states, Hidden and Revealed",
        "statement": "Once a tile is revealed it stays revealed; there is no third remembered-but-out-of-sight state."
      },
      {
        "decisionId": "opaque-text-authority-for-html",
        "disposition": "accepted",
        "source": "Projector registry constraint: lossless-source-tokens.v1 only admits the javascript and typescript languages",
        "statement": "Govern the shipped file as one exact-byte utf8-text.v1 artifact instead of decomposing it under JavaScript source authority, since the deliverable is one mixed HTML document rather than an isolated JS module."
      },
      {
        "decisionId": "corridor-shape",
        "disposition": "modified",
        "source": "Option A wording describes carving straight hallway connections",
        "statement": "Connect sibling BSP rooms with a single straight hallway segment."
      },
      {
        "decisionId": "review-markdown-for-team",
        "disposition": "accepted",
        "source": "Request to hand the team a document they can review",
        "statement": "Project a contract-derived architecture review Markdown document alongside the game file."
      },
      {
        "decisionId": "automated-runtime-conformance-check",
        "disposition": "deferred",
        "source": "Conformance evaluation is available as an optional declared command check",
        "statement": "Add an automated headless-browser command that exercises the canvas gameplay loop as a conformance evaluation."
      }
    ],
    "deviations": [
      {
        "decisionId": "corridor-shape",
        "impact": "Corridors bend once instead of running perfectly straight; the BSP connectivity guarantee and overall structure are unchanged.",
        "implemented": "Connect sibling BSP room centers with a randomized two-segment (L-shaped) corridor.",
        "proposed": "Connect sibling BSP rooms with a single straight hallway segment.",
        "reason": "A single straight segment cannot join two room centers unless they already share a row or column; an L-shaped two-segment corridor is the minimal deterministic extension that still guarantees a connected path between any sibling pair."
      }
    ],
