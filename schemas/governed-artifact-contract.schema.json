{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.local/schemas/governed-artifact-contract.schema.json",
  "title": "Governed Artifact Contract",
  "description": "Admitted authority for one complete artifact family and its conformance proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schema",
    "subject",
    "workspace",
    "projectorRegistry",
    "verifierRegistry",
    "projectionLedger",
    "dependencies",
    "effects",
    "runtimeAuthorities",
    "artifacts",
    "authorityClosure",
    "exclusions",
    "conformance",
    "receipt",
    "claims"
  ],
  "properties": {
    "$schema": {
      "const": "https://canonical.local/schemas/governed-artifact-contract.schema.json"
    },
    "contract": {
      "$ref": "#/$defs/contractIdentity"
    },
    "schema": {
      "$ref": "#/$defs/admittedDependency"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "projectorRegistry": {
      "$ref": "#/$defs/admittedDependency"
    },
    "verifierRegistry": {
      "$ref": "#/$defs/admittedDependency"
    },
    "projectionLedger": {
      "$ref": "#/$defs/projectionLedger"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "runtimeAuthorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/runtimeAuthority"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "authorityClosure": {
      "$ref": "#/$defs/authorityClosure"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claimPolicy"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "invocation": {
      "type": "string",
      "pattern": "^(?:new )?[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "minLength": 1,
      "maxLength": 320
    },
    "contractIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType",
        "contractId",
        "status",
        "contractVersion"
      ],
      "properties": {
        "contractType": {
          "const": "governed-artifact-contract.v1"
        },
        "contractId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "admitted"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "admittedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorityClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "coverage",
        "resolution",
        "admission"
      ],
      "properties": {
        "authorityType": {
          "const": "closed-world-authority-closure.v1"
        },
        "coverage": {
          "const": {
            "artifactPaths": "exact",
            "artifactScope": "exact",
            "claimProofRequirements": "exact",
            "declarations": "exact",
            "dependencies": "exact",
            "dependencyImports": "exact",
            "dependencyInvocations": "exact",
            "decisions": "exact",
            "effects": "exact",
            "failurePolicies": "exact",
            "iterations": "exact",
            "projectionMappings": "exact",
            "responsibilities": "exact",
            "resultContracts": "exact",
            "runtimeAuthorities": "exact",
            "semanticEdges": "exact"
          }
        },
        "resolution": {
          "const": {
            "ambiguousObservations": "reject",
            "ambientAuthority": "forbidden",
            "cardinality": "exactly-one",
            "missingDeclaredAuthorities": "reject",
            "undeclaredObservations": "reject",
            "unresolvedObservations": "reject"
          }
        },
        "admission": {
          "const": {
            "requiredDisposition": "ARTIFACT_AUTHORITY_CLOSED"
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "subjectId",
        "purpose",
        "authority"
      ],
      "properties": {
        "subjectType": {
          "$ref": "#/$defs/identifier"
        },
        "subjectId": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority": true
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceRoot",
        "artifactRoot",
        "governedScope"
      ],
      "properties": {
        "workspaceRoot": {
          "$ref": "#/$defs/relativePath"
        },
        "artifactRoot": {
          "$ref": "#/$defs/relativePath"
        },
        "governedScope": {
          "$ref": "#/$defs/governedScope"
        }
      }
    },
    "governedScope": {
      "oneOf": [
        {
          "$ref": "#/$defs/exclusiveSubtreeScope"
        },
        {
          "$ref": "#/$defs/declaredArtifactScope"
        }
      ]
    },
    "exclusiveSubtreeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "inventoryMode",
        "governedDirectories",
        "outsideScopePosture",
        "requiredDisposition"
      ],
      "properties": {
        "scopeType": {
          "const": "exclusive-artifact-subtree.v1"
        },
        "inventoryMode": {
          "const": "exclusive-subtree"
        },
        "governedDirectories": {
          "const": []
        },
        "outsideScopePosture": {
          "const": "outside-authority"
        },
        "requiredDisposition": {
          "const": "ARTIFACT_SCOPE_CLOSED"
        }
      }
    },
    "declaredArtifactScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scopeType",
        "inventoryMode",
        "governedDirectories",
        "outsideScopePosture",
        "requiredDisposition"
      ],
      "properties": {
        "scopeType": {
          "const": "declared-artifact-scope.v1"
        },
        "inventoryMode": {
          "const": "declared-paths"
        },
        "governedDirectories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "outsideScopePosture": {
          "const": "outside-authority"
        },
        "requiredDisposition": {
          "const": "ARTIFACT_SCOPE_CLOSED"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactKind",
        "purpose",
        "relativePath",
        "mediaType",
        "ownership",
        "mutabilityPosture",
        "projection",
        "relationships",
        "proof"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "artifactKind": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "ownership": {
          "enum": [
            "contract-owned",
            "admitted-external"
          ]
        },
        "mutabilityPosture": {
          "enum": [
            "replace-by-projection",
            "immutable",
            "admitted"
          ]
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "sourceAuthority": {
          "$ref": "#/$defs/sourceAuthority"
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyId",
        "specifier",
        "allowedImports",
        "allowedInvocations",
        "usedByArtifacts",
        "authority"
      ],
      "properties": {
        "dependencyId": {
          "$ref": "#/$defs/identifier"
        },
        "specifier": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "allowedImports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?:\\*|default|[A-Za-z_$][A-Za-z0-9_$]*)$"
          },
          "uniqueItems": true
        },
        "allowedInvocations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:\\*|default|[A-Za-z_$][A-Za-z0-9_$]*)(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
          },
          "uniqueItems": true
        },
        "usedByArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "authority": {
          "oneOf": [
            {
              "$ref": "#/$defs/portAuthority"
            },
            {
              "$ref": "#/$defs/artifactAuthority"
            }
          ]
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectId",
        "operation",
        "usedByArtifacts",
        "authority"
      ],
      "properties": {
        "effectId": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)*$"
        },
        "usedByArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "authority": {
          "$ref": "#/$defs/portAuthority"
        }
      }
    },
    "runtimeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeAuthorityId",
        "invocation",
        "usedByArtifacts",
        "purpose"
      ],
      "properties": {
        "runtimeAuthorityId": {
          "$ref": "#/$defs/identifier"
        },
        "invocation": {
          "$ref": "#/$defs/invocation"
        },
        "usedByArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "portAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "portId",
        "effect"
      ],
      "properties": {
        "authorityType": {
          "const": "port-authority.v1"
        },
        "portId": {
          "$ref": "#/$defs/identifier"
        },
        "effect": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "artifactAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "artifactId",
        "responsibilityId",
        "semanticEdge"
      ],
      "properties": {
        "authorityType": {
          "const": "artifact-authority.v1"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "semanticEdge": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "sourceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declarations",
        "responsibilities",
        "semanticEdges",
        "decisions",
        "iterations",
        "failurePolicies",
        "projectionMappings",
        "resultContracts",
        "forbiddenSyntaxKinds"
      ],
      "properties": {
        "declarations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$"
          },
          "uniqueItems": true
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/responsibility"
          }
        },
        "semanticEdges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/semanticEdge"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decisionAuthority"
          }
        },
        "iterations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/iterationAuthority"
          }
        },
        "failurePolicies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failurePolicy"
          }
        },
        "projectionMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectionMapping"
          }
        },
        "resultContracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultContract"
          }
        },
        "forbiddenSyntaxKinds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/syntaxKind"
          },
          "uniqueItems": true
        }
      }
    },
    "responsibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responsibilityId",
        "responsibilityType",
        "declaration",
        "purpose"
      ],
      "properties": {
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityType": {
          "enum": [
            "function",
            "module"
          ]
        },
        "declaration": {
          "type": "string",
          "pattern": "^(?:<module>|[A-Za-z_$][A-Za-z0-9_$]*)$"
        },
        "functionKind": {
          "enum": [
            "arrow-function",
            "function-declaration",
            "function-expression",
            "method-declaration"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "responsibilityType": {
                "const": "function"
              }
            }
          },
          "then": {
            "properties": {
              "functionKind": {}
            },
            "required": [
              "functionKind"
            ]
          },
          "else": {
            "not": {
              "required": [
                "functionKind"
              ]
            }
          }
        }
      ]
    },
    "semanticEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edgeId",
        "responsibilityId",
        "edgeKind",
        "operation",
        "argumentExpressions",
        "occurrences",
        "authorities",
        "purpose"
      ],
      "properties": {
        "edgeId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "edgeKind": {
          "enum": [
            "invocation",
            "reference"
          ]
        },
        "operation": {
          "$ref": "#/$defs/invocation"
        },
        "argumentExpressions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityReference"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authorityReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/dependencyAuthorityReference"
        },
        {
          "$ref": "#/$defs/effectAuthorityReference"
        },
        {
          "$ref": "#/$defs/runtimeAuthorityReference"
        },
        {
          "$ref": "#/$defs/responsibilityAuthorityReference"
        },
        {
          "$ref": "#/$defs/projectionAuthorityReference"
        },
        {
          "$ref": "#/$defs/failureAuthorityReference"
        },
        {
          "$ref": "#/$defs/resultAuthorityReference"
        }
      ]
    },
    "dependencyAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "dependencyId"
      ],
      "properties": {
        "authorityType": {
          "const": "dependency-authority"
        },
        "dependencyId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "effectAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "effectId"
      ],
      "properties": {
        "authorityType": {
          "const": "effect-authority"
        },
        "effectId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "runtimeAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "runtimeAuthorityId"
      ],
      "properties": {
        "authorityType": {
          "const": "runtime-authority"
        },
        "runtimeAuthorityId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "responsibilityAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "responsibilityId"
      ],
      "properties": {
        "authorityType": {
          "const": "responsibility-authority"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "projectionAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "projectionMappingId"
      ],
      "properties": {
        "authorityType": {
          "const": "projection-authority"
        },
        "projectionMappingId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "failureAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "failurePolicyId"
      ],
      "properties": {
        "authorityType": {
          "const": "failure-authority"
        },
        "failurePolicyId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "resultAuthorityReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "resultContractId"
      ],
      "properties": {
        "authorityType": {
          "const": "result-authority"
        },
        "resultContractId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "decisionAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "responsibilityId",
        "syntaxKind",
        "conditionExpression",
        "occurrences",
        "policy"
      ],
      "properties": {
        "decisionId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "syntaxKind": {
          "enum": [
            "ConditionalExpression",
            "IfStatement",
            "LogicalAndExpression",
            "LogicalOrExpression",
            "NullishCoalescingExpression",
            "SwitchStatement"
          ]
        },
        "conditionExpression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "iterationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iterationId",
        "responsibilityId",
        "syntaxKind",
        "controlExpression",
        "occurrences",
        "continuationPolicy",
        "terminationPolicy"
      ],
      "properties": {
        "iterationId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "syntaxKind": {
          "enum": [
            "DoStatement",
            "ForStatement",
            "WhileStatement"
          ]
        },
        "controlExpression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "continuationPolicy": {
          "type": "string",
          "minLength": 1
        },
        "terminationPolicy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "failurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failurePolicyId",
        "responsibilityId",
        "syntaxKind",
        "occurrences",
        "policy"
      ],
      "properties": {
        "failurePolicyId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "syntaxKind": {
          "enum": [
            "CatchClause",
            "ThrowStatement",
            "TryStatement"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "syntaxKind"
            ],
            "properties": {
              "syntaxKind": {
                "const": "ThrowStatement"
              }
            }
          },
          "then": {
            "required": [
              "expression"
            ],
            "properties": {
              "expression": {}
            }
          }
        }
      ]
    },
    "projectionMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionMappingId",
        "responsibilityId",
        "occurrences",
        "fields",
        "purpose"
      ],
      "properties": {
        "projectionMappingId": {
          "$ref": "#/$defs/identifier"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/projectionField"
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectionField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputField",
        "sourceExpression"
      ],
      "properties": {
        "outputField": {
          "type": "string",
          "minLength": 1
        },
        "sourceExpression": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resultContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultContractId",
        "resultKind",
        "mediaType",
        "source",
        "purpose"
      ],
      "properties": {
        "resultContractId": {
          "$ref": "#/$defs/identifier"
        },
        "resultKind": {
          "$ref": "#/$defs/identifier"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/returnResultSource"
            },
            {
              "$ref": "#/$defs/effectResultSource"
            }
          ]
        },
        "projectionMapping": {
          "$ref": "#/$defs/projectionMappingReference"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "returnResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "responsibilityId",
        "returnKind",
        "expression",
        "occurrences"
      ],
      "properties": {
        "sourceType": {
          "const": "return"
        },
        "responsibilityId": {
          "$ref": "#/$defs/identifier"
        },
        "returnKind": {
          "enum": [
            "explicit-return",
            "implicit-return"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "effectResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "effectId",
        "semanticEdgeId",
        "argumentIndex",
        "valueExpression",
        "occurrences"
      ],
      "properties": {
        "sourceType": {
          "const": "effect"
        },
        "effectId": {
          "$ref": "#/$defs/identifier"
        },
        "semanticEdgeId": {
          "$ref": "#/$defs/identifier"
        },
        "argumentIndex": {
          "type": "integer",
          "minimum": 0
        },
        "valueExpression": {
          "type": "string",
          "minLength": 1
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "projectionMappingReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "projectionMappingId"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "projectionMappingId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "syntaxKind": {
      "enum": [
        "CatchClause",
        "ConditionalExpression",
        "DebuggerStatement",
        "DoStatement",
        "DynamicImportExpression",
        "ForStatement",
        "IfStatement",
        "LogicalAndExpression",
        "LogicalOrExpression",
        "NullishCoalescingExpression",
        "ObjectLiteralExpression",
        "ReturnStatement",
        "SwitchStatement",
        "ThrowStatement",
        "TryStatement",
        "WhileStatement",
        "WithStatement"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "projectorId",
        "authorityId",
        "authority"
      ],
      "properties": {
        "mode": {
          "enum": [
            "projected",
            "admitted"
          ]
        },
        "projectorId": {
          "$ref": "#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "#/$defs/identifier"
        },
        "authority": {
          "oneOf": [
            {
              "$ref": "#/$defs/jsonAuthority"
            },
            {
              "$ref": "#/$defs/textAuthority"
            },
            {
              "$ref": "#/$defs/tokenAuthority"
            },
            {
              "$ref": "#/$defs/contractMarkdownAuthority"
            }
          ]
        }
      }
    },
    "jsonAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "value"
      ],
      "properties": {
        "authorityType": {
          "const": "canonical-json-value.v1"
        },
        "value": true
      }
    },
    "textAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "text"
      ],
      "properties": {
        "authorityType": {
          "const": "utf8-text.v1"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "tokenAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "language",
        "tokens"
      ],
      "properties": {
        "authorityType": {
          "const": "lossless-source-tokens.v1"
        },
        "language": {
          "enum": [
            "javascript",
            "typescript"
          ]
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "contractMarkdownAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "documentTitle",
        "documentStatusLabel",
        "futureStatePreview",
        "reviewerPerspective",
        "sectionOrder",
        "reviewChecklist"
      ],
      "properties": {
        "authorityType": {
          "const": "governed-artifact-contract-markdown.v1"
        },
        "documentTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "documentStatusLabel": {
          "const": "Governed review projection"
        },
        "futureStatePreview": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!#)(?!```)[^\\r\\n]+$"
          }
        },
        "reviewerPerspective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "objective",
            "outcome"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            }
          }
        },
        "sectionOrder": {
          "const": [
            "future-state-preview",
            "reviewer-perspective",
            "governing-loop",
            "contract-authority",
            "semantic-subject",
            "artifact-family",
            "projection-authorities",
            "dependency-authorities",
            "effect-authorities",
            "runtime-authorities",
            "source-authority-closures",
            "authority-closure-profile",
            "artifact-scope-authority",
            "artifact-relationships",
            "exclusions",
            "conformance-evaluation",
            "terminal-dispositions",
            "receipt-requirements",
            "claim-policies",
            "review-checklist"
          ]
        },
        "reviewChecklist": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipType",
        "artifactId"
      ],
      "properties": {
        "relationshipType": {
          "$ref": "#/$defs/identifier"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierIds",
        "contentDigestRequired",
        "contentSha256",
        "expectedByteLength"
      ],
      "properties": {
        "verifierIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "contentDigestRequired": {
          "const": true
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedByteLength": {
          "type": "integer",
          "minimum": 0
        },
        "metaSchemaValidationRequired": {
          "const": true
        },
        "requiredSections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#{1,6} [^\\r\\n]+$"
          },
          "uniqueItems": true
        },
        "forbiddenText": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "validThroughUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failClosed",
        "evaluationOrder",
        "artifactEvaluations",
        "terminalDispositions"
      ],
      "properties": {
        "failClosed": {
          "const": true
        },
        "evaluationOrder": {
          "const": [
            "validate-contract",
            "resolve-artifact-plan",
            "observe-artifact-state",
            "evaluate-artifact-inventory",
            "evaluate-projection-identity",
            "evaluate-authority-closure",
            "evaluate-artifact-content",
            "evaluate-artifact-structure",
            "evaluate-artifact-freshness",
            "evaluate-artifact-relationships",
            "evaluate-declared-commands",
            "issue-trust-disposition"
          ]
        },
        "artifactEvaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactEvaluation"
          }
        },
        "terminalDispositions": {
          "$ref": "#/$defs/terminalDispositions"
        }
      }
    },
    "terminalDispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractValidation",
        "artifactConformance",
        "trustPostures",
        "trustDispositions"
      ],
      "properties": {
        "contractValidation": {
          "const": [
            "CONTRACT_VALID",
            "CONTRACT_INVALID",
            "SCHEMA_NOT_ADMITTED",
            "SCHEMA_DIGEST_MISMATCH"
          ]
        },
        "artifactConformance": {
          "const": [
            "ARTIFACT_MISSING",
            "ARTIFACT_UNDECLARED",
            "ARTIFACT_CONTENT_MISMATCH",
            "ARTIFACT_STRUCTURE_MISMATCH",
            "ARTIFACT_STALE",
            "PROJECTION_IDENTITY_MISMATCH",
            "ARTIFACT_ESCAPES_CONTRACT",
            "CONTRACT_AUTHORITY_CLOSED"
          ]
        },
        "trustPostures": {
          "const": [
            "CONFORMS",
            "DRIFTED",
            "MISSING",
            "EXTRA",
            "STALE",
            "CONTAMINATED",
            "NOT_EVALUATED"
          ]
        },
        "trustDispositions": {
          "const": [
            "TRUSTED",
            "REJECTED",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "artifactEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "verifierId",
        "command",
        "expectedExitCode",
        "expectedStdoutContains"
      ],
      "properties": {
        "evaluationId": {
          "$ref": "#/$defs/identifier"
        },
        "verifierId": {
          "const": "command-exit-verifier.v1"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedExitCode": {
          "type": "integer"
        },
        "expectedStdoutContains": {
          "type": "string"
        }
      }
    },
    "claimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimId",
        "claim",
        "requiredConformanceDisposition",
        "requiredAuthorityClosureDisposition",
        "requiredScopeDisposition",
        "requiredProofDisposition",
        "requiredTrustDisposition"
      ],
      "properties": {
        "claimId": {
          "$ref": "#/$defs/identifier"
        },
        "claim": {
          "enum": [
            "COMPLETE",
            "CONTRACT_AUTHORITY_CLOSED",
            "TRUSTED"
          ]
        },
        "requiredConformanceDisposition": {
          "const": "CONTRACT_AUTHORITY_CLOSED"
        },
        "requiredAuthorityClosureDisposition": {
          "const": "ARTIFACT_AUTHORITY_CLOSED"
        },
        "requiredScopeDisposition": {
          "const": "ARTIFACT_SCOPE_CLOSED"
        },
        "requiredProofDisposition": {
          "const": "PROOF_COMPLETE"
        },
        "requiredTrustDisposition": {
          "const": "TRUSTED"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "relativePath",
        "requiredEvidence"
      ],
      "properties": {
        "receiptType": {
          "const": "governed-artifact-conformance-receipt.v1"
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "requiredEvidence": {
          "const": [
            "contract-identity",
            "schema-identity",
            "registry-identities",
            "artifact-observations",
            "projection-identity",
            "artifact-scope-authority",
            "artifact-scope-observation",
            "authority-closure-profile",
            "authority-closure-disposition",
            "source-authority-observations",
            "conformance-findings",
            "claim-policies",
            "trust-disposition"
          ]
        }
      }
    },
    "projectionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerType",
        "relativePath",
        "requiredEvidence"
      ],
      "properties": {
        "ledgerType": {
          "const": "governed-artifact-projection-ledger.v1"
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "requiredEvidence": {
          "const": [
            "contract-identity",
            "projector-registry-identity",
            "artifact-scope-authority",
            "authority-closure-profile",
            "dependency-authorities",
            "effect-authorities",
            "runtime-authorities",
            "source-authorities",
            "artifact-projection-identities",
            "artifact-content-commitments"
          ]
        }
      }
    }
  }
}
