{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.local/schemas/executable-mechanic-authority.schema.json",
  "title": "Executable mechanic authority",
  "description": "A closed, reviewed authority envelope for one exact executable-mechanic occurrence or one authority-first mechanic.",
  "type": "object",
  "allOf": [
    { "$ref": "#/$defs/commonEnvelope" },
    {
      "oneOf": [
        { "$ref": "#/$defs/decisionEnvelope" },
        { "$ref": "#/$defs/iterationEnvelope" },
        { "$ref": "#/$defs/failureEnvelope" },
        { "$ref": "#/$defs/terminalEnvelope" },
        { "$ref": "#/$defs/projectionEnvelope" },
        { "$ref": "#/$defs/serializationEnvelope" },
        { "$ref": "#/$defs/canonicalizationEnvelope" },
        { "$ref": "#/$defs/constraintEnvelope" },
        { "$ref": "#/$defs/alternativeEnvelope" },
        { "$ref": "#/$defs/retryEnvelope" },
        { "$ref": "#/$defs/stateTransitionEnvelope" },
        { "$ref": "#/$defs/textMeaningEnvelope" }
      ]
    }
  ],
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "minLength": 1, "maxLength": 240 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "disposition": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "minLength": 1 },
    "identifierArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "dispositionArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/disposition" } },
    "decisionRule": { "type": "object", "additionalProperties": false, "required": ["ruleId", "inputId", "outcomeId"], "properties": { "ruleId": { "$ref": "#/$defs/identifier" }, "inputId": { "$ref": "#/$defs/identifier" }, "outcomeId": { "$ref": "#/$defs/identifier" } } },
    "decisionOutcome": { "type": "object", "additionalProperties": false, "required": ["outcomeId", "outputId", "disposition"], "properties": { "outcomeId": { "$ref": "#/$defs/identifier" }, "outputId": { "$ref": "#/$defs/identifier" }, "disposition": { "$ref": "#/$defs/disposition" } } },
    "failureObservation": { "type": "object", "additionalProperties": false, "required": ["failureId", "operationId"], "properties": { "failureId": { "$ref": "#/$defs/identifier" }, "operationId": { "$ref": "#/$defs/identifier" } } },
    "failureDisposition": { "type": "object", "additionalProperties": false, "required": ["failureId", "disposition"], "properties": { "failureId": { "$ref": "#/$defs/identifier" }, "disposition": { "$ref": "#/$defs/disposition" } } },
    "fieldMapping": { "type": "object", "additionalProperties": false, "required": ["inputId", "outputId"], "properties": { "inputId": { "$ref": "#/$defs/identifier" }, "outputId": { "$ref": "#/$defs/identifier" } } },
    "serializationRule": { "type": "object", "additionalProperties": false, "required": ["ruleId", "operation"], "properties": { "ruleId": { "$ref": "#/$defs/identifier" }, "operation": { "$ref": "#/$defs/identifier" } } },
    "canonicalizationOperation": { "type": "object", "additionalProperties": false, "required": ["operationId", "operation"], "properties": { "operationId": { "$ref": "#/$defs/identifier" }, "operation": { "$ref": "#/$defs/identifier" } } },
    "constraintRule": { "type": "object", "additionalProperties": false, "required": ["constraintId", "inputId", "operator"], "properties": { "constraintId": { "$ref": "#/$defs/identifier" }, "inputId": { "$ref": "#/$defs/identifier" }, "operator": { "$ref": "#/$defs/identifier" } } },
    "alternative": { "type": "object", "additionalProperties": false, "required": ["alternativeId", "operationId"], "properties": { "alternativeId": { "$ref": "#/$defs/identifier" }, "operationId": { "$ref": "#/$defs/identifier" } } },
    "backoff": { "type": "object", "additionalProperties": false, "required": ["strategy", "delayMs"], "properties": { "strategy": { "enum": ["none", "fixed", "exponential"] }, "delayMs": { "type": "integer", "minimum": 0 } } },
    "stateTransition": { "type": "object", "additionalProperties": false, "required": ["transitionId", "fromState", "toState"], "properties": { "transitionId": { "$ref": "#/$defs/identifier" }, "fromState": { "$ref": "#/$defs/identifier" }, "toState": { "$ref": "#/$defs/identifier" } } },
    "stateGuard": { "type": "object", "additionalProperties": false, "required": ["guardId", "inputId"], "properties": { "guardId": { "$ref": "#/$defs/identifier" }, "inputId": { "$ref": "#/$defs/identifier" } } },
    "textMeaning": { "type": "object", "additionalProperties": false, "required": ["token", "disposition"], "properties": { "token": { "type": "string", "minLength": 1 }, "disposition": { "$ref": "#/$defs/disposition" } } },
    "textTemplate": { "type": "object", "additionalProperties": false, "required": ["templateId", "pattern"], "properties": { "templateId": { "$ref": "#/$defs/identifier" }, "pattern": { "type": "string", "minLength": 1 } } },
    "commonEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityType", "mechanicAuthorityId", "mechanicKind", "lineage", "semanticSubject", "inputs", "authority", "outputs", "execution", "proof", "sourceEvidence", "lifecycle"],
      "properties": {
        "authorityType": { "const": "executable-mechanic-authority.v1" },
        "mechanicAuthorityId": { "$ref": "#/$defs/identifier" },
        "mechanicKind": { "enum": ["branch", "iteration", "exception-handling", "throw", "object-construction", "serialization", "normalization", "validation", "fallback", "retry", "state-mutation", "meaning-hidden-in-text"] },
        "lineage": {
          "type": "object", "additionalProperties": false,
          "required": ["featureId", "scenarioId", "obligationId", "responsibilityId", "artifactId"],
          "properties": {
            "featureId": { "$ref": "#/$defs/identifier" }, "scenarioId": { "$ref": "#/$defs/identifier" },
            "obligationId": { "$ref": "#/$defs/identifier" }, "responsibilityId": { "$ref": "#/$defs/identifier" },
            "artifactId": { "$ref": "#/$defs/identifier" }
          }
        },
        "semanticSubject": {
          "type": "object", "additionalProperties": false, "required": ["subjectId", "purpose"],
          "properties": { "subjectId": { "$ref": "#/$defs/identifier" }, "purpose": { "type": "string", "minLength": 1 } }
        },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/valuePort" } },
        "authority": { "type": "object" },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/valuePort" } },
        "execution": {
          "type": "object", "additionalProperties": false, "required": ["origin", "sequence", "operations"],
          "properties": {
            "origin": { "enum": ["observed-source", "authority-first"] },
            "sequence": { "type": "integer", "minimum": 1 },
            "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operation" } }
          }
        },
        "proof": {
          "type": "object", "additionalProperties": false, "required": ["requirementIds"],
          "properties": { "requirementIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } } }
        },
        "sourceEvidence": { "type": "array", "items": { "$ref": "#/$defs/sourceEvidence" } },
        "lifecycle": {
          "type": "object", "additionalProperties": false, "required": ["status", "admissionDisposition"],
          "properties": {
            "status": { "enum": ["proposed", "reviewed", "admitted", "retired"] },
            "admissionDisposition": { "enum": ["INFERRED_NOT_ADMITTED", "HUMAN_SEMANTIC_COMPLETION_REQUIRED", "AUTHORITY_REVIEWED", "AUTHORITY_ADMITTED", "AUTHORITY_RETIRED"] }
          },
          "allOf": [
            { "if": { "type": "object", "properties": { "status": { "const": "admitted" } }, "required": ["status"] }, "then": { "type": "object", "properties": { "admissionDisposition": { "const": "AUTHORITY_ADMITTED" } } } },
            { "if": { "type": "object", "properties": { "admissionDisposition": { "const": "AUTHORITY_ADMITTED" } }, "required": ["admissionDisposition"] }, "then": { "type": "object", "properties": { "status": { "const": "admitted" } } } }
          ]
        }
      },
      "allOf": [
        { "if": { "type": "object", "properties": { "execution": { "type": "object", "properties": { "origin": { "const": "observed-source" } }, "required": ["origin"] } } }, "then": { "type": "object", "properties": { "sourceEvidence": { "type": "array", "minItems": 1 } } } },
        { "if": { "type": "object", "properties": { "execution": { "type": "object", "properties": { "origin": { "const": "authority-first" } }, "required": ["origin"] } } }, "then": { "type": "object", "properties": { "sourceEvidence": { "type": "array", "maxItems": 0 } } } }
      ]
    },
    "valuePort": {
      "type": "object", "additionalProperties": false, "required": ["valueId", "conceptId"],
      "properties": { "valueId": { "$ref": "#/$defs/identifier" }, "conceptId": { "$ref": "#/$defs/identifier" }, "required": { "type": "boolean" } }
    },
    "operation": {
      "type": "object", "additionalProperties": false, "required": ["stepId", "operation"],
      "properties": { "stepId": { "$ref": "#/$defs/identifier" }, "operation": { "$ref": "#/$defs/identifier" }, "bindingId": { "$ref": "#/$defs/identifier" } }
    },
    "sourceEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceFactIndexId", "rootId", "mechanicOccurrenceId", "sourceReferenceId", "sourceFileDigest", "observedMechanicKind"],
      "properties": {
        "sourceFactIndexId": { "$ref": "#/$defs/sha256" }, "rootId": { "$ref": "#/$defs/identifier" },
        "mechanicOccurrenceId": { "$ref": "#/$defs/sha256" }, "sourceReferenceId": { "type": "string", "minLength": 1 },
        "sourceFileDigest": { "$ref": "#/$defs/sha256" },
        "observedMechanicKind": { "enum": ["branch", "iteration", "exception-handling", "throw", "object-construction", "serialization", "normalization", "validation", "fallback", "retry", "state-mutation", "meaning-hidden-in-text"] }
      }
    },
    "decisionAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "decision-authority.v1" }, "inputs": { "$ref": "#/$defs/identifierArray" }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionRule" } }, "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decisionOutcome" } }, "noMatchDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "inputs", "rules", "outcomes", "noMatchDisposition"] },
    "iterationAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "iteration-authority.v1" }, "collectionInputId": { "$ref": "#/$defs/identifier" }, "itemBindingId": { "$ref": "#/$defs/identifier" }, "ordering": { "$ref": "#/$defs/identifier" }, "continuation": { "$ref": "#/$defs/disposition" }, "termination": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "collectionInputId", "itemBindingId", "ordering", "continuation", "termination"] },
    "failureAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "failure-observation-authority.v1" }, "observedFailures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/failureObservation" } }, "dispositions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/failureDisposition" } }, "unhandledDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "observedFailures", "dispositions", "unhandledDisposition"] },
    "terminalAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "terminal-disposition-authority.v1" }, "terminalDisposition": { "$ref": "#/$defs/disposition" }, "resultOutputId": { "$ref": "#/$defs/identifier" } }, "required": ["authorityKind", "terminalDisposition", "resultOutputId"] },
    "projectionAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "semantic-projection-authority.v1" }, "projectionId": { "$ref": "#/$defs/identifier" }, "fieldMappings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fieldMapping" } }, "unmappedFieldDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "projectionId", "fieldMappings", "unmappedFieldDisposition"] },
    "serializationAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "serialization-profile-authority.v1" }, "profileId": { "$ref": "#/$defs/identifier" }, "mediaType": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$" }, "encoding": { "$ref": "#/$defs/identifier" }, "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/serializationRule" } } }, "required": ["authorityKind", "profileId", "mediaType", "encoding", "rules"] },
    "canonicalizationAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "canonicalization-authority.v1" }, "inputId": { "$ref": "#/$defs/identifier" }, "outputId": { "$ref": "#/$defs/identifier" }, "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalizationOperation" } }, "ambiguityDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "inputId", "outputId", "operations", "ambiguityDisposition"] },
    "constraintAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "constraint-authority.v1" }, "inputIds": { "$ref": "#/$defs/identifierArray" }, "constraints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/constraintRule" } }, "validOutcome": { "$ref": "#/$defs/disposition" }, "invalidOutcome": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "inputIds", "constraints", "validOutcome", "invalidOutcome"] },
    "alternativeAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "alternative-selection-authority.v1" }, "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/alternative" } }, "selectionOrder": { "$ref": "#/$defs/identifierArray" }, "exhaustedDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "alternatives", "selectionOrder", "exhaustedDisposition"] },
    "retryAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "retry-policy-authority.v1" }, "operationId": { "$ref": "#/$defs/identifier" }, "maximumAttempts": { "type": "integer", "minimum": 1 }, "retryableDispositions": { "$ref": "#/$defs/dispositionArray" }, "backoff": { "$ref": "#/$defs/backoff" }, "exhaustedDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "operationId", "maximumAttempts", "retryableDispositions", "backoff", "exhaustedDisposition"] },
    "stateTransitionAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "state-transition-authority.v1" }, "stateId": { "$ref": "#/$defs/identifier" }, "fromStates": { "$ref": "#/$defs/identifierArray" }, "transitions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateTransition" } }, "guards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stateGuard" } }, "effectId": { "$ref": "#/$defs/identifier" } }, "required": ["authorityKind", "stateId", "fromStates", "transitions", "guards", "effectId"] },
    "textMeaningAuthority": { "$ref": "#/$defs/authorityObject", "additionalProperties": false, "properties": { "authorityKind": { "const": "text-meaning-authority.v1" }, "vocabularyId": { "$ref": "#/$defs/identifier" }, "meanings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textMeaning" } }, "templates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/textTemplate" } }, "unknownTextDisposition": { "$ref": "#/$defs/disposition" } }, "required": ["authorityKind", "vocabularyId", "meanings", "templates", "unknownTextDisposition"] },
    "authorityObject": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "authorityKind", "inputs", "rules", "outcomes", "noMatchDisposition",
          "collectionInputId", "itemBindingId", "ordering", "continuation", "termination",
          "observedFailures", "dispositions", "unhandledDisposition", "terminalDisposition", "resultOutputId",
          "projectionId", "fieldMappings", "unmappedFieldDisposition", "profileId", "mediaType", "encoding",
          "inputId", "outputId", "operations", "ambiguityDisposition", "inputIds", "constraints",
          "validOutcome", "invalidOutcome", "alternatives", "selectionOrder", "exhaustedDisposition",
          "operationId", "maximumAttempts", "retryableDispositions", "backoff", "stateId", "fromStates",
          "transitions", "guards", "effectId", "vocabularyId", "meanings", "templates", "unknownTextDisposition"
        ]
      }
    },
    "decisionEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "branch" }, "authority": { "$ref": "#/$defs/decisionAuthority" } } },
    "iterationEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "iteration" }, "authority": { "$ref": "#/$defs/iterationAuthority" } } },
    "failureEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "exception-handling" }, "authority": { "$ref": "#/$defs/failureAuthority" } } },
    "terminalEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "throw" }, "authority": { "$ref": "#/$defs/terminalAuthority" } } },
    "projectionEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "object-construction" }, "authority": { "$ref": "#/$defs/projectionAuthority" } } },
    "serializationEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "serialization" }, "authority": { "$ref": "#/$defs/serializationAuthority" } } },
    "canonicalizationEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "normalization" }, "authority": { "$ref": "#/$defs/canonicalizationAuthority" } } },
    "constraintEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "validation" }, "authority": { "$ref": "#/$defs/constraintAuthority" } } },
    "alternativeEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "fallback" }, "authority": { "$ref": "#/$defs/alternativeAuthority" } } },
    "retryEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "retry" }, "authority": { "$ref": "#/$defs/retryAuthority" } } },
    "stateTransitionEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "state-mutation" }, "authority": { "$ref": "#/$defs/stateTransitionAuthority" } } },
    "textMeaningEnvelope": { "type": "object", "$ref": "#/$defs/envelopeVariant", "properties": { "mechanicKind": { "const": "meaning-hidden-in-text" }, "authority": { "$ref": "#/$defs/textMeaningAuthority" } } },
    "envelopeVariant": { "type": "object", "required": ["mechanicKind", "authority"], "properties": { "mechanicKind": {}, "authority": {} } }
  }
}
