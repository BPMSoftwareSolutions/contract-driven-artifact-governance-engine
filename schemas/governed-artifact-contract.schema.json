{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canonical.local/schemas/governed-artifact-contract.schema.json",
  "title": "Governed Artifact Contract",
  "description": "Admitted authority for one complete artifact family and its conformance proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract",
    "schema",
    "subject",
    "workspace",
    "projectorRegistry",
    "verifierRegistry",
    "projectionLedger",
    "artifacts",
    "exclusions",
    "conformance",
    "receipt"
  ],
  "properties": {
    "$schema": {
      "const": "https://canonical.local/schemas/governed-artifact-contract.schema.json"
    },
    "contract": {
      "$ref": "#/$defs/contractIdentity"
    },
    "schema": {
      "$ref": "#/$defs/admittedDependency"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "projectorRegistry": {
      "$ref": "#/$defs/admittedDependency"
    },
    "verifierRegistry": {
      "$ref": "#/$defs/admittedDependency"
    },
    "projectionLedger": {
      "$ref": "#/$defs/projectionLedger"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relativePath"
      },
      "uniqueItems": true
    },
    "conformance": {
      "$ref": "#/$defs/conformance"
    },
    "receipt": {
      "$ref": "#/$defs/receipt"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 160
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
      "minLength": 1,
      "maxLength": 320
    },
    "contractIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractType",
        "contractId",
        "status",
        "contractVersion"
      ],
      "properties": {
        "contractType": {
          "const": "governed-artifact-contract.v1"
        },
        "contractId": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "const": "admitted"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "admittedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "digest"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectType",
        "subjectId",
        "purpose",
        "authority"
      ],
      "properties": {
        "subjectType": {
          "$ref": "#/$defs/identifier"
        },
        "subjectId": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "authority": true
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactRoot"
      ],
      "properties": {
        "artifactRoot": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactKind",
        "purpose",
        "relativePath",
        "mediaType",
        "ownership",
        "mutabilityPosture",
        "projection",
        "relationships",
        "proof"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/identifier"
        },
        "artifactKind": {
          "$ref": "#/$defs/identifier"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
        },
        "ownership": {
          "enum": [
            "contract-owned",
            "admitted-external"
          ]
        },
        "mutabilityPosture": {
          "enum": [
            "replace-by-projection",
            "immutable",
            "admitted"
          ]
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "proof": {
          "$ref": "#/$defs/proof"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "projectorId",
        "authorityId",
        "authority"
      ],
      "properties": {
        "mode": {
          "enum": [
            "projected",
            "admitted"
          ]
        },
        "projectorId": {
          "$ref": "#/$defs/identifier"
        },
        "authorityId": {
          "$ref": "#/$defs/identifier"
        },
        "authority": {
          "oneOf": [
            {
              "$ref": "#/$defs/jsonAuthority"
            },
            {
              "$ref": "#/$defs/textAuthority"
            },
            {
              "$ref": "#/$defs/tokenAuthority"
            },
            {
              "$ref": "#/$defs/contractMarkdownAuthority"
            }
          ]
        }
      }
    },
    "jsonAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "value"
      ],
      "properties": {
        "authorityType": {
          "const": "canonical-json-value.v1"
        },
        "value": true
      }
    },
    "textAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "text"
      ],
      "properties": {
        "authorityType": {
          "const": "utf8-text.v1"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "tokenAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "language",
        "tokens"
      ],
      "properties": {
        "authorityType": {
          "const": "lossless-source-tokens.v1"
        },
        "language": {
          "enum": [
            "javascript",
            "typescript"
          ]
        },
        "tokens": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "contractMarkdownAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityType",
        "documentTitle",
        "documentStatusLabel",
        "futureStatePreview",
        "reviewerPerspective",
        "sectionOrder",
        "reviewChecklist"
      ],
      "properties": {
        "authorityType": {
          "const": "governed-artifact-contract-markdown.v1"
        },
        "documentTitle": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\r\\n]+$"
        },
        "documentStatusLabel": {
          "const": "Governed review projection"
        },
        "futureStatePreview": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!#)(?!```)[^\\r\\n]+$"
          }
        },
        "reviewerPerspective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "objective",
            "outcome"
          ],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "objective": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            },
            "outcome": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\r\\n]+$"
            }
          }
        },
        "sectionOrder": {
          "const": [
            "future-state-preview",
            "reviewer-perspective",
            "governing-loop",
            "contract-authority",
            "semantic-subject",
            "artifact-family",
            "projection-authorities",
            "artifact-relationships",
            "exclusions",
            "conformance-evaluation",
            "terminal-dispositions",
            "receipt-requirements",
            "review-checklist"
          ]
        },
        "reviewChecklist": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipType",
        "artifactId"
      ],
      "properties": {
        "relationshipType": {
          "$ref": "#/$defs/identifier"
        },
        "artifactId": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierIds",
        "contentDigestRequired",
        "contentSha256",
        "expectedByteLength"
      ],
      "properties": {
        "verifierIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "contentDigestRequired": {
          "const": true
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectedByteLength": {
          "type": "integer",
          "minimum": 0
        },
        "metaSchemaValidationRequired": {
          "const": true
        },
        "requiredSections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^#{1,6} [^\\r\\n]+$"
          },
          "uniqueItems": true
        },
        "forbiddenText": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "validThroughUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failClosed",
        "evaluationOrder",
        "artifactEvaluations",
        "terminalDispositions"
      ],
      "properties": {
        "failClosed": {
          "const": true
        },
        "evaluationOrder": {
          "const": [
            "validate-contract",
            "resolve-artifact-plan",
            "observe-artifact-state",
            "evaluate-artifact-inventory",
            "evaluate-projection-identity",
            "evaluate-artifact-content",
            "evaluate-artifact-structure",
            "evaluate-artifact-freshness",
            "evaluate-artifact-relationships",
            "evaluate-declared-commands",
            "issue-trust-disposition"
          ]
        },
        "artifactEvaluations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactEvaluation"
          }
        },
        "terminalDispositions": {
          "$ref": "#/$defs/terminalDispositions"
        }
      }
    },
    "terminalDispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractValidation",
        "artifactConformance",
        "trustPostures",
        "trustDispositions"
      ],
      "properties": {
        "contractValidation": {
          "const": [
            "CONTRACT_VALID",
            "CONTRACT_INVALID",
            "SCHEMA_NOT_ADMITTED",
            "SCHEMA_DIGEST_MISMATCH"
          ]
        },
        "artifactConformance": {
          "const": [
            "ARTIFACT_FAMILY_CONFORMS",
            "ARTIFACT_MISSING",
            "ARTIFACT_UNDECLARED",
            "ARTIFACT_CONTENT_MISMATCH",
            "ARTIFACT_STRUCTURE_MISMATCH",
            "ARTIFACT_STALE",
            "PROJECTION_IDENTITY_MISMATCH"
          ]
        },
        "trustPostures": {
          "const": [
            "CONFORMS",
            "DRIFTED",
            "MISSING",
            "EXTRA",
            "STALE",
            "NOT_EVALUATED"
          ]
        },
        "trustDispositions": {
          "const": [
            "TRUSTED",
            "REJECTED",
            "NOT_EVALUATED"
          ]
        }
      }
    },
    "artifactEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluationId",
        "verifierId",
        "command",
        "expectedExitCode",
        "expectedStdoutContains"
      ],
      "properties": {
        "evaluationId": {
          "$ref": "#/$defs/identifier"
        },
        "verifierId": {
          "const": "command-exit-verifier.v1"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedExitCode": {
          "type": "integer"
        },
        "expectedStdoutContains": {
          "type": "string"
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiptType",
        "relativePath",
        "requiredEvidence"
      ],
      "properties": {
        "receiptType": {
          "const": "governed-artifact-conformance-receipt.v1"
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "requiredEvidence": {
          "const": [
            "contract-identity",
            "schema-identity",
            "registry-identities",
            "artifact-observations",
            "projection-identity",
            "conformance-findings",
            "trust-disposition"
          ]
        }
      }
    },
    "projectionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerType",
        "relativePath",
        "requiredEvidence"
      ],
      "properties": {
        "ledgerType": {
          "const": "governed-artifact-projection-ledger.v1"
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "requiredEvidence": {
          "const": [
            "contract-identity",
            "projector-registry-identity",
            "artifact-projection-identities",
            "artifact-content-commitments"
          ]
        }
      }
    }
  }
}
